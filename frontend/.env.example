# Base URL of the Laravel API (apps/api)
API_BASE_URL=http://127.0.0.1:8000/api

# Shared secret sent as X-App-Key on every backend call.
# Must match APP_API_KEY in apps/api/.env
APP_API_KEY=

# Secret used to sign the httpOnly session cookie.
# Required — must be at least 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional SMTP settings for password-reset emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
