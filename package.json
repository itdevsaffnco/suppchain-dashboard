{
  "name": "suppchain-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace scm-dashboard",
    "dev:api": "php apps/api/artisan serve --host=127.0.0.1 --port=8000",
    "build": "npm run build --workspace scm-dashboard",
    "start": "npm run start --workspace scm-dashboard",
    "lint": "npm run lint --workspace scm-dashboard",
    "api:migrate": "php apps/api/artisan migrate",
    "api:seed": "php apps/api/artisan db:seed",
    "api:fresh": "php apps/api/artisan migrate:fresh --seed",
    "api:test": "php apps/api/artisan test",
    "api:route": "php apps/api/artisan route:list --path=api",
    "seed:sync": "node scripts/generate-seed.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
